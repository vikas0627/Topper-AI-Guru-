rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles: Only owner can write, any authenticated user can read (for leaderboard)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Tasks: Only the student who owns the task can read/write
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid);
    }

    // Results: Only the student who owns the result can read/write
    match /results/{resultId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid);
    }

    // Default: Deny everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
